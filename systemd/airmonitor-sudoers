# Passwordless sudo for the exact commands the collector's self-healing and
# the dashboard's system controls need — nothing broader.
# Installed to /etc/sudoers.d/airmonitor by `make deploy-full` / `make install`.
# Paths are listed in the variants seen across Pi OS releases; sudoers
# matches on the exact resolved path.

# Wi-Fi recovery ladder (airmonitor/wifi_recovery.py)
pi ALL=(root) NOPASSWD: /usr/bin/nmcli radio wifi off, /usr/bin/nmcli radio wifi on
pi ALL=(root) NOPASSWD: /usr/bin/ip link set wlan0 down, /usr/bin/ip link set wlan0 up
pi ALL=(root) NOPASSWD: /usr/sbin/ip link set wlan0 down, /usr/sbin/ip link set wlan0 up
pi ALL=(root) NOPASSWD: /bin/ip link set wlan0 down, /bin/ip link set wlan0 up
pi ALL=(root) NOPASSWD: /usr/bin/systemctl restart NetworkManager
pi ALL=(root) NOPASSWD: /usr/bin/systemctl restart wpa_supplicant dhcpcd
pi ALL=(root) NOPASSWD: /bin/systemctl restart NetworkManager
pi ALL=(root) NOPASSWD: /bin/systemctl restart wpa_supplicant dhcpcd

# Dashboard system controls (service restart / reboot commands)
pi ALL=(root) NOPASSWD: /usr/bin/systemctl restart airmonitor, /usr/bin/systemctl restart airmonitor-web
pi ALL=(root) NOPASSWD: /bin/systemctl restart airmonitor, /bin/systemctl restart airmonitor-web
pi ALL=(root) NOPASSWD: /usr/sbin/reboot, /sbin/reboot
