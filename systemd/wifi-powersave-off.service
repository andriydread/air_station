[Unit]
Description=Disable Wi-Fi power management (brcmfmac hang mitigation)
# The Pi Zero 2 W's brcmfmac driver can wedge the Wi-Fi stack with power save
# on. The extra power draw is negligible.
After=network.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for tool in /usr/sbin/iw /sbin/iw iw; do command -v "$tool" >/dev/null 2>&1 && exec "$tool" dev wlan0 set power_save off; done; echo "iw not found" >&2; exit 1'

[Install]
WantedBy=multi-user.target
