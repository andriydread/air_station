# Rendered by `make init` / `make deploy` into /etc/systemd/system/airstation-manager.service
# (@USER@ and @REPO@ are filled in with the operator's user and the checkout path).
[Unit]
Description=Air station manager (e-paper, weather, machine, maintenance)
After=network-online.target
Wants=network-online.target
# No start-rate limit: with Restart=always the app may crash-loop every 5 s
# forever (a sensor unplugged, the database locked) rather than systemd
# giving up after five tries. (Unit-section key; in [Service] it is ignored.)
StartLimitIntervalSec=0

[Service]
# Type=notify + WatchdogSec: the app sends READY=1 once started and WATCHDOG=1
# every 10 s from its single loop (shared/heartbeat.py). A loop wedged for
# 90 s is killed and restarted by systemd.
Type=notify
WatchdogSec=90
ExecStart=@REPO@/.venv/bin/python -m manager
WorkingDirectory=@REPO@
User=@USER@
StandardOutput=journal
StandardError=journal
# Crash loops retry every 5 s (see StartLimitIntervalSec in [Unit]).
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
