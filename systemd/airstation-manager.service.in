# Rendered by `make init` / `make deploy` into /etc/systemd/system/airstation-manager.service
# (@USER@ and @REPO@ become the user and the checkout path).
[Unit]
Description=Air station manager (e-paper, weather, machine, maintenance)
After=network-online.target
Wants=network-online.target
# No start-rate limit: keep retrying every 5 s instead of giving up after
# five tries. This key belongs in [Unit]; in [Service] it is ignored.
StartLimitIntervalSec=0

[Service]
# The app sends READY=1 after startup and WATCHDOG=1 every 10 s from its loop
# (shared/heartbeat.py); systemd restarts it if the loop is stuck for 90 s.
Type=notify
WatchdogSec=90
ExecStart=@REPO@/.venv/bin/python -m manager
WorkingDirectory=@REPO@
User=@USER@
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
